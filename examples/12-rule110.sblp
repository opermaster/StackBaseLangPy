    row1 deref 13 ' ' arr_set
    row1 deref 14 ' ' arr_set
    row1 deref 15 '*' arr_set
    row1 deref 16 ' ' arr_set
    row1 deref 17 ' ' arr_set
    row1 deref 18 ' ' arr_set
    row1 deref 19 ' ' arr_set
    row1 deref 20 ' ' arr_set
    row1 deref 21 '*' arr_set
    row1 deref 22 ' ' arr_set
    row1 deref 23 ' ' arr_set
    row1 deref 24 ' ' arr_set
    row1 deref 25 ' ' arr_set
    row1 deref 26 ' ' arr_set
    row1 deref 27 ' ' arr_set
    row1 deref 28 '*' arr_set
    row1 deref 29 '*' arr_set

    let int i
    while{
        i deref  150 =< do
        row1 deref row2 deref calculate_next_row row2 store
        row1 deref print_array
        row1 deref row2 deref swap_rows row1 store row2 store
        i deref 1 + i store
    }
    
