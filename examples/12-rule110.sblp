func print_array{
    /* array */
    let int len
    let array nums
    let int i
    nums store
    nums deref sizeof len store
    len deref 1 - len store
    while {
        i deref len deref =<
        do
        nums deref i deref get deref
        "%c " printf
        i deref 1 + i store
    }
    "\n" printf
}
func calculate_next_row{
    let array row1
    let array row2
    let int len
    let int i
        
    row2 store
    row1 store
    1 i store   
    row1 deref sizeof len store
    len deref 2 - len store

    while{
        i deref len deref =< do
        let char left
        let char cent
        let char right
        
        row1 deref i deref 1 - get deref left store 
        row1 deref i deref get deref     cent store 
        row1 deref i deref 1 + get deref right store 

        left deref '*' == cent deref '*' == right deref '*' == and and if{

            ' ' row2 deref i deref get store
        }
        
        left deref '*' == cent deref '*' == right deref ' ' == and and if{

             '*' row2 deref i deref get store
        }
        
        left deref '*' == cent deref ' ' == right deref '*' == and and if{

             '*' row2 deref i deref get store
        }
        
        left deref '*' == cent deref ' ' == right deref ' ' == and and if{

             ' ' row2 deref i deref  get store
        }
        
        left deref ' ' == cent deref '*' == right deref '*' == and and if{

            '*'  row2 deref i deref   get store
        }
        left deref ' ' == cent deref '*' == right deref ' ' == and and if{

            '*'  row2 deref i deref  get store
        }
        left deref ' ' == cent deref ' ' == right deref '*' == and and if{
 
             '*' row2 deref  i deref  get store
        }
        left deref ' ' == cent deref ' ' == right deref ' ' == and and if{

             ' ' row2 deref i deref  get store
        }
        i deref 1 + i store
        
    }
    row2 deref
}
func swap_rows{
    let array row1
    let array row2
    let array temp
               
    row2 store
    row1 store
        
    row2 deref temp store 
    row1 deref row2 store
    temp deref row1 store
        
    row2 deref
    row1 deref
}
func main{
    let int size
    30 size store
    size deref let [char] row1
    size deref let [char] row2
    ' ' row2 deref  0  get store
    '*' row2 deref  size deref 1 - get store
    
    row1 deref print_array
    '*' row1 deref  0  get store
    '*' row1 deref  1  get store
    ' ' row1 deref  2  get store
    '*' row1 deref  3  get store
    ' ' row1 deref  4  get store
    ' ' row1 deref  5  get store
    ' ' row1 deref  6  get store
    ' ' row1 deref  7  get store
    '*' row1 deref  8  get store
    ' ' row1 deref  9  get store
    ' ' row1 deref 10  get store
    '*' row1 deref 11  get store
    ' ' row1 deref 12  get store
    ' ' row1 deref 13  get store
    ' ' row1 deref 14  get store
    '*' row1 deref 15  get store
    ' ' row1 deref 16  get store
    ' ' row1 deref 17  get store
    ' ' row1 deref 18  get store
    ' ' row1 deref 19  get store
    ' ' row1 deref 20  get store
    '*' row1 deref 21  get store
    ' ' row1 deref 22  get store
    ' ' row1 deref 23 get store
    ' ' row1 deref 24 get store
    ' ' row1 deref 25 get store
    ' ' row1 deref 26 get store
    ' ' row1 deref 27 get store
    '*' row1 deref 28 get store
    '*' row1 deref 29 get store

    let int i
    while{
        i deref  150 =< do
        row1 deref row2 deref calculate_next_row row2 store
        row1 deref print_array
        row1 deref row2 deref swap_rows row1 store row2 store
        i deref 1 + i store
    }
    
    /*row1 deref 1 'b' arr_set
        
