func print_array{
    /* array */
    let int len
    let array nums
    let int i
    nums store
    nums deref sizeof len store
    len deref 1 - len store
    while {
        i deref len deref =<
        do
        nums deref i deref arr_get
        "%c " printf
        i deref 1 + i store
    }
    "\n" printf
}
func calculate_next_row{
    let array row1
    let array row2
    let int len
    let int i
        
    row2 store
    row1 store
    1 i store   
    row1 deref sizeof len store
    len deref 2 - len store

    while{
        i deref len deref =< do
        let char left
        let char cent
        let char right
        
        row1 deref i deref 1 - arr_get left store 
        row1 deref i deref arr_get     cent store 
        row1 deref i deref 1 + arr_get right store 

        left deref '*' == cent deref '*' == right deref '*' == and and if{

             row2 deref i deref ' '  arr_set
        }
        
        left deref '*' == cent deref '*' == right deref ' ' == and and if{

             row2 deref i deref '*'  arr_set
        }
        
        left deref '*' == cent deref ' ' == right deref '*' == and and if{

             row2 deref i deref '*'  arr_set
        }
        
        left deref '*' == cent deref ' ' == right deref ' ' == and and if{

             row2 deref i deref ' '  arr_set
        }
        
        left deref ' ' == cent deref '*' == right deref '*' == and and if{

             row2 deref i deref '*' arr_set
        }
        left deref ' ' == cent deref '*' == right deref ' ' == and and if{

             row2 deref i deref '*'  arr_set
        }
        left deref ' ' == cent deref ' ' == right deref '*' == and and if{
 
             row2 deref  i deref '*' arr_set
        }
        left deref ' ' == cent deref ' ' == right deref ' ' == and and if{

             row2 deref i deref ' '  arr_set
        }
        i deref 1 + i store
        
    }
    row2 deref
}
func swap_rows{
    let array row1
    let array row2
    let array temp
               
    row2 store
    row1 store
        
    row2 deref temp store 
    row1 deref row2 store
    temp deref row1 store
        
    row2 deref
    row1 deref
}
